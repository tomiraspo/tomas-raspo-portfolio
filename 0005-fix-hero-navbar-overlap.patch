From aae5b8daacaa98bb3f78b6187de0add62f2ac3ee Mon Sep 17 00:00:00 2001
From: Tomas Juan Raspo <121737284+tomiraspo@users.noreply.github.com>
Date: Sun, 30 Aug 2026 23:32:07 +0000
Subject: [PATCH] fix(hero): evitar que la foto de perfil se superponga con el
 navbar

El Navbar es 'fixed top-0' con altura 64px (h-16). El Hero no
reservaba espacio para eso, entonces en ventanas de navegador mas
bajas (zoom alto, pantalla chica, ventana no maximizada), el
contenido centrado verticalmente empujaba la foto hacia arriba,
tapando los links 'Skills' y 'Projects' del menu.

Se agrega padding-top (pt-24) y padding-bottom al section del Hero
para garantizar espacio libre debajo del navbar sin importar la
altura de la ventana. Verificado en 1920x1080, 1366x768 y en el
caso que reproducia el bug (1366x600).
---
 src/components/Hero.tsx | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/components/Hero.tsx b/src/components/Hero.tsx
index 8d4c8f4..6cc6de9 100644
--- a/src/components/Hero.tsx
+++ b/src/components/Hero.tsx
@@ -16,7 +16,7 @@ const Hero = () => {
   const { displayedText, isDone } = useTypewriter(roleText, 35, 400);
 
   return (
-    <section className="min-h-screen flex items-center justify-center relative overflow-hidden px-4">
+    <section className="min-h-screen flex items-center justify-center relative overflow-hidden px-4 pt-24 pb-12">
       {/* Grid pattern de fondo, estilo "blueprint" tecnico */}
       <div
         className="absolute inset-0 opacity-[0.07] dark:opacity-[0.12]"
-- 
